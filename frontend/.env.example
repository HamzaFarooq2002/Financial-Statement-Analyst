# Optional: full API URL (skips Vite proxy). Example for remote backend:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Dev default: leave VITE_API_BASE_URL unset — the app uses /api and Vite proxies to FastAPI.

# If FastAPI is not on 8000, point the dev proxy at it (used by vite.config.ts):
# VITE_API_PROXY_TARGET=http://127.0.0.1:9000

# Client-side abort for POST /process & /compare (ms). Must exceed worst-case backend time:
# VITE_PROCESSING_TIMEOUT_MS=600000

# Vite → FastAPI proxy must stay open for long requests or Chrome shows ERR_CONNECTION_RESET:
# VITE_API_PROXY_TIMEOUT_MS=600000
