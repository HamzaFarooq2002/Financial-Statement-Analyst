APP_NAME="AI Financial Report Analyst API"
API_PREFIX="/api"
DATABASE_URL="sqlite:///./financial_agent.db"
UPLOAD_DIR="./uploads"
EXPORT_DIR="./exports"
MAX_UPLOAD_MB=50
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:3000","http://127.0.0.1:3000"]
CORS_ORIGIN_REGEX="^http://(localhost|127\\.0\\.0\\.1):\\d+$"
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_TIMEOUT_SECONDS=45
# HTTP 429 / transient errors: exponential backoff (total attempts = 1 + GEMINI_MAX_RETRIES)
GEMINI_MAX_RETRIES=5
GEMINI_RETRY_BASE_SECONDS=2
GEMINI_RETRY_MAX_DELAY_SECONDS=60
# google-genai internal HTTP retries (keep low to avoid hammering API on 429)
GEMINI_HTTP_SDK_RETRIES=2
PROCESSING_TIMEOUT_SECONDS=300
